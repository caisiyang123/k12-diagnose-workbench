{
  "name": "dsh-k12-diagnose-workbench",
  "version": "1.3.0",
  "type": "module",
  "private": true,
  "description": "中小学·高中知识图谱工作台：原站（cn-math-taxonomy）1:1 完整嵌入，含知识图谱浏览、自适应诊断、孩子档案（本机离线，数据不上传）。",
  "author": "caisiyang123",
  "license": "CC-BY-NC-4.0",
  "main": "dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches"
      ],
      "external": []
    }
  },
  "files": [
    "dsh",
    "lib",
    "site",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5",
    "@deepseek-ai/schemastery": ">=3.18.4 <4"
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.mjs",
    "pack": "node build.mjs && pnpm pack"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caisiyang123/k12-diagnose-workbench.git"
  },
  "keywords": [
    "dsh-workbench",
    "k12",
    "knowledge-graph",
    "diagnostic",
    "education",
    "adaptive-testing"
  ]
}